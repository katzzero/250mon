#!/usr/bin/env python3
"""
250mon-serve - WebSocket + HTTP server for 250mon state
Streams /run/250mon/state.json to connected clients.
  - WebSocket on port 25052 (default)
  - HTTP GET / on port 25053 (default)
"""

import asyncio
import json
import os
import signal
import sys
from http.server import HTTPServer, BaseHTTPRequestHandler
from threading import Thread

try:
    import websockets
except ImportError:
    print("Error: websockets module not found. Install with: pip install websockets", file=sys.stderr)
    sys.exit(1)

STATE_DIR = "/run/250mon"
STATE_FILE = os.path.join(STATE_DIR, "state.json")
DEFAULT_WS_PORT = 25052
DEFAULT_HTTP_PORT = 25053
DEFAULT_INTERVAL = 1.0

connected = set()
running = True


def read_state():
    try:
        with open(STATE_FILE, "r") as f:
            return f.read().strip()
    except (FileNotFoundError, PermissionError):
        return json.dumps({"error": "state unavailable"})


# WebSocket handler
async def ws_handler(websocket):
    connected.add(websocket)
    try:
        await websocket.send(read_state())
        async for _ in websocket:
            pass
    finally:
        connected.discard(websocket)


async def broadcaster(interval):
    while running:
        if connected:
            state = read_state()
            await asyncio.gather(
                *[ws.send(state) for ws in connected.copy()],
                return_exceptions=True,
            )
        await asyncio.sleep(interval)


# HTTP handler
class StateHTTPHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/" or self.path == "/state":
            state = read_state()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(state.encode())
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass  # Suppress HTTP logs


def start_http_server(port):
    server = HTTPServer(("0.0.0.0", port), StateHTTPHandler)
    server.serve_forever()


def shutdown(sig, frame):
    global running
    running = False


def main():
    ws_port = DEFAULT_WS_PORT
    http_port = DEFAULT_HTTP_PORT
    interval = DEFAULT_INTERVAL

    if len(sys.argv) > 1:
        try:
            ws_port = int(sys.argv[1])
        except ValueError:
            pass
    if len(sys.argv) > 2:
        try:
            http_port = int(sys.argv[2])
        except ValueError:
            pass
    if len(sys.argv) > 3:
        try:
            interval = float(sys.argv[3])
        except ValueError:
            pass

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    # Start HTTP server in background thread
    http_thread = Thread(target=start_http_server, args=(http_port,), daemon=True)
    http_thread.start()
    print(f"HTTP server on http://0.0.0.0:{http_port}")

    async def serve():
        print(f"WebSocket server on ws://0.0.0.0:{ws_port}")
        async with websockets.serve(ws_handler, "0.0.0.0", ws_port):
            await broadcaster(interval)

    asyncio.run(serve())


if __name__ == "__main__":
    main()

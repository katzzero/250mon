#!/usr/bin/env bash
#
# hw-logger - Log GPU and CPU metrics for AMD Cyan Skillfish (BC-250) APU
#

set -euo pipefail

VERSION="0.1.0"

usage() {
    cat <<EOF
hw-logger v${VERSION} - AMD Cyan Skillfish hardware logger

Usage: hw-logger [OPTIONS]

Component selection (default: both GPU and CPU):
  --gpu               Log GPU metrics only
  --cpu               Log CPU metrics only

Options:
  -i, --interval MS   Sampling interval in milliseconds (default: 1000)
  -f, --format FMT    Output format: csv or json (default: csv)
  -o, --output FILE   Log to file (default: ~/hwlog-YYYYMMDD-HHMMSS.<ext>)
  -q, --quiet         Suppress stdout, write to file only
  -c, --count N       Number of samples then exit (default: infinite)
  --live              Full-screen live dashboard (Ctrl+C to exit)
  --plot              Generate plot after logging (default: 30 samples)
  --draw              Print ASCII chart after logging (default: 30 samples)
  --plot-metrics M    Metrics to plot (comma-separated, passed to hw-draw)
  -h, --help          Show this help message
  -v, --version       Show version

GPU Metrics:
  gpu_freq_mhz        GPU shader clock (MHz)
  gpu_voltage_mv      GPU core voltage (mV)
  gpu_temp_c          GPU temperature (°C)
  gpu_load_pct        GPU busy percentage (null if unsupported)
  gpu_mem_clock_mhz   GPU memory clock (MHz)
  gpu_power_w         GPU power draw (W)
  gpu_vram_used_mib   VRAM used (MiB)
  gpu_vram_total_mib  VRAM total (MiB)

CPU Metrics:
  cpu_freq_mhz        Average CPU frequency (MHz)
  cpu_temp_c          CPU temperature (°C, from k10temp)
  cpu_usage_pct       Aggregate CPU usage percentage
  nvme_temp_c         NVMe drive temperature (°C)

Examples:
  hw-logger                              # Log to ~/hwlog-YYYYMMDD-HHMMSS.csv
  hw-logger --gpu -i 100 -f json         # GPU only, 100ms interval, JSON
  hw-logger --cpu -i 500 -c 60           # CPU only, 500ms, 60 samples
  hw-logger -i 2000 -o hw.csv -q         # Custom file, quiet
  hw-logger --live                       # Full-screen live dashboard
  hw-logger --draw -c 30                 # Log 30 samples then show chart
  hw-logger --plot -c 50                 # Log 50 samples then save plot
EOF
}

VERSION="0.1.0"

# Defaults
INTERVAL_MS=1000
FORMAT="csv"
OUTPUT=""
QUIET=false
COUNT=0
LOG_GPU=true
LOG_CPU=true
PLOT=false
DRAW=false
LIVE=false
PLOT_METRICS=""

# GPU sysfs base path
GPU_PATH=""

# Previous CPU stat for usage calculation
PREV_CPU_TOTAL=0
PREV_CPU_IDLE=0

# --- Argument parsing ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --gpu)
            LOG_GPU=true
            LOG_CPU=false
            shift
            ;;
        --cpu)
            LOG_GPU=false
            LOG_CPU=true
            shift
            ;;
        -i|--interval)
            INTERVAL_MS="$2"
            shift 2
            ;;
        -f|--format)
            FORMAT="$2"
            shift 2
            ;;
        -o|--output)
            OUTPUT="$2"
            shift 2
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -c|--count)
            COUNT="$2"
            shift 2
            ;;
        --plot)
            PLOT=true
            shift
            ;;
        --draw)
            DRAW=true
            shift
            ;;
        --live)
            LIVE=true
            shift
            ;;
        --plot-metrics)
            PLOT_METRICS="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            echo "hw-logger v${VERSION}"
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# If --draw or --plot without -c, set a default count
if [[ ("$PLOT" == true || "$DRAW" == true) && "$COUNT" -eq 0 ]]; then
    COUNT=30
fi

# --- Validation ---
if [[ "$FORMAT" != "csv" && "$FORMAT" != "json" ]]; then
    echo "Error: Invalid format '$FORMAT'. Use 'csv' or 'json'." >&2
    exit 1
fi

if ! [[ "$INTERVAL_MS" =~ ^[0-9]+$ ]] || [[ "$INTERVAL_MS" -lt 1 ]]; then
    echo "Error: Interval must be a positive integer (ms)." >&2
    exit 1
fi

# --- Default output path ---
if [[ -z "$OUTPUT" ]]; then
    _ext="csv"
    [[ "$FORMAT" == "json" ]] && _ext="jsonl"
    OUTPUT="${HOME}/hwlog-$(date '+%Y%m%d-%H%M%S').${_ext}"
fi

# --- Find GPU sysfs path ---
find_gpu_path() {
    local card
    for card in /sys/class/drm/card*/device; do
        if [[ -f "$card/pp_dpm_sclk" ]]; then
            echo "$card"
            return 0
        fi
    done
    return 1
}

if [[ "$LOG_GPU" == true ]]; then
    GPU_PATH=$(find_gpu_path) || {
        echo "Warning: AMD GPU sysfs not found, disabling GPU logging." >&2
        LOG_GPU=false
    }
fi

# --- GPU reading functions ---
read_gpu_freq() {
    grep '\*' "$GPU_PATH/pp_dpm_sclk" 2>/dev/null | head -1 | sed -n 's/^[0-9]*: \([0-9]*\)Mhz.*/\1/p'
}

read_gpu_voltage() {
    grep '^OD_VDDC:' -A1 "$GPU_PATH/pp_od_clk_voltage" 2>/dev/null | tail -1 | sed -n 's/^[0-9]*: \([0-9]*\)mV.*/\1/p'
}

read_gpu_temp() {
    local hwmon_dir="$GPU_PATH/hwmon"
    local hwmon temp_file raw
    for hwmon in "$hwmon_dir"/*/; do
        temp_file="${hwmon}temp1_input"
        if [[ -f "$temp_file" ]]; then
            raw=$(cat "$temp_file" 2>/dev/null) || return 0
            if [[ -n "$raw" ]]; then
                awk "BEGIN {printf \"%.1f\", $raw / 1000}"
                return 0
            fi
        fi
    done
}

read_gpu_load() {
    local busy_file="$GPU_PATH/gpu_busy_percent"
    if [[ -f "$busy_file" ]]; then
        local val
        val=$(cat "$busy_file" 2>/dev/null) || return 0
        echo "$val" | tr -d '[:space:]'
    fi
}

read_gpu_mem_clock() {
    grep '\*' "$GPU_PATH/pp_dpm_mclk" 2>/dev/null | head -1 | sed -n 's/^[0-9]*: \([0-9]*\)Mhz.*/\1/p'
}

read_gpu_power() {
    local hwmon_dir="$GPU_PATH/hwmon"
    local hwmon power_file raw
    for hwmon in "$hwmon_dir"/*/; do
        power_file="${hwmon}power1_average"
        if [[ -f "$power_file" ]]; then
            raw=$(cat "$power_file" 2>/dev/null) || return 0
            if [[ -n "$raw" ]]; then
                awk "BEGIN {printf \"%.1f\", $raw / 1000000}"
                return 0
            fi
        fi
    done
}

read_gpu_vram_used() {
    local f="$GPU_PATH/mem_info_vram_used"
    if [[ -f "$f" ]]; then
        local val
        val=$(cat "$f" 2>/dev/null) || return 0
        awk "BEGIN {printf \"%.0f\", $val / 1048576}"
    fi
}

read_gpu_vram_total() {
    local f="$GPU_PATH/mem_info_vram_total"
    if [[ -f "$f" ]]; then
        local val
        val=$(cat "$f" 2>/dev/null) || return 0
        awk "BEGIN {printf \"%.0f\", $val / 1048576}"
    fi
}

# --- CPU reading functions ---
read_cpu_freq() {
    # Average frequency across all cores from /proc/cpuinfo
    awk '/^cpu MHz/ {sum += $4; n++} END {if (n>0) printf "%.0f", sum/n; else print ""}' /proc/cpuinfo 2>/dev/null
}

read_cpu_temp() {
    # k10temp from hwmon
    local hwmon_dir="/sys/class/hwmon"
    local hwmon name_file temp_file
    for hwmon in "$hwmon_dir"/*/; do
        name_file="${hwmon}name"
        if [[ -f "$name_file" ]]; then
            name=$(cat "$name_file" 2>/dev/null)
            if [[ "$name" == "k10temp" ]]; then
                temp_file="${hwmon}temp1_input"
                if [[ -f "$temp_file" ]]; then
                    local raw
                    raw=$(cat "$temp_file" 2>/dev/null) || return 0
                    if [[ -n "$raw" ]]; then
                        awk "BEGIN {printf \"%.1f\", $raw / 1000}"
                        return 0
                    fi
                fi
            fi
        fi
    done
}

read_cpu_usage() {
    # Read /proc/stat and calculate CPU usage since last call
    local vals
    vals=$(awk '/^cpu / && !/^cpu[0-9]/ {
        printf "%s %s %s %s %s %s %s %s", $2, $3, $4, $5, $6, $7, $8, $9
        exit
    }' /proc/stat 2>/dev/null) || return 0

    local user nice system idle iowait irq softirq steal
    read -r user nice system idle iowait irq softirq steal <<< "$vals"

    local total=$((user + nice + system + idle + iowait + irq + softirq + steal))
    local idle_total=$((idle + iowait))

    if [[ "$PREV_CPU_TOTAL" -gt 0 ]]; then
        local delta_total=$((total - PREV_CPU_TOTAL))
        local delta_idle=$((idle_total - PREV_CPU_IDLE))
        if [[ "$delta_total" -gt 0 ]]; then
            awk "BEGIN {printf \"%.1f\", (1 - $delta_idle / $delta_total) * 100}"
        fi
    fi

    PREV_CPU_TOTAL=$total
    PREV_CPU_IDLE=$idle_total
}

# --- NVMe reading function ---
read_nvme_temp() {
    local hwmon_dir="/sys/class/hwmon"
    local hwmon name_file temp_file
    for hwmon in "$hwmon_dir"/*/; do
        name_file="${hwmon}name"
        if [[ -f "$name_file" ]]; then
            name=$(cat "$name_file" 2>/dev/null)
            if [[ "$name" == "nvme" ]]; then
                temp_file="${hwmon}temp1_input"
                if [[ -f "$temp_file" ]]; then
                    local raw
                    raw=$(cat "$temp_file" 2>/dev/null) || return 0
                    if [[ -n "$raw" ]]; then
                        awk "BEGIN {printf \"%.1f\", $raw / 1000}"
                        return 0
                    fi
                fi
            fi
        fi
    done
}

# --- Output functions ---
timestamp() {
    date '+%Y-%m-%dT%H:%M:%S%z'
}

emit_csv_header() {
    local header="timestamp"
    [[ "$LOG_GPU" == true ]] && header+=",gpu_freq_mhz,gpu_voltage_mv,gpu_temp_c,gpu_load_pct,gpu_mem_clock_mhz,gpu_power_w,gpu_vram_used_mib,gpu_vram_total_mib"
    [[ "$LOG_CPU" == true ]] && header+=",cpu_freq_mhz,cpu_temp_c,cpu_usage_pct,nvme_temp_c"
    echo "$header"
}

emit_csv() {
    local ts="$1"
    local gpu_freq="$2" gpu_volt="$3" gpu_temp="$4" gpu_load="$5" gpu_mem="$6"
    local gpu_power="$7" gpu_vram_used="$8" gpu_vram_total="$9"
    local cpu_freq="${10}" cpu_temp="${11}" cpu_usage="${12}" nvme_temp="${13}"

    local line="$ts"
    if [[ "$LOG_GPU" == true ]]; then
        line+=",${gpu_freq},${gpu_volt},${gpu_temp},${gpu_load},${gpu_mem}"
        line+=",${gpu_power},${gpu_vram_used},${gpu_vram_total}"
    fi
    if [[ "$LOG_CPU" == true ]]; then
        line+=",${cpu_freq},${cpu_temp},${cpu_usage},${nvme_temp}"
    fi
    echo "$line"
}

json_val() {
    # Return "null" for empty, or the value quoted for strings, unquoted for numbers
    local val="$1" type="${2:-string}"
    if [[ -z "$val" ]]; then
        echo "null"
    elif [[ "$type" == "string" ]]; then
        printf '"%s"' "$val"
    else
        echo "$val"
    fi
}

emit_json() {
    local ts="$1"
    local gpu_freq="$2" gpu_volt="$3" gpu_temp="$4" gpu_load="$5" gpu_mem="$6"
    local gpu_power="$7" gpu_vram_used="$8" gpu_vram_total="$9"
    local cpu_freq="${10}" cpu_temp="${11}" cpu_usage="${12}" nvme_temp="${13}"

    printf '{"timestamp":"%s"' "$ts"

    if [[ "$LOG_GPU" == true ]]; then
        printf ',"gpu_freq_mhz":%s' "$(json_val "$gpu_freq" num)"
        printf ',"gpu_voltage_mv":%s' "$(json_val "$gpu_volt" num)"
        printf ',"gpu_temp_c":%s' "$(json_val "$gpu_temp" num)"
        printf ',"gpu_load_pct":%s' "$(json_val "$gpu_load" num)"
        printf ',"gpu_mem_clock_mhz":%s' "$(json_val "$gpu_mem" num)"
        printf ',"gpu_power_w":%s' "$(json_val "$gpu_power" num)"
        printf ',"gpu_vram_used_mib":%s' "$(json_val "$gpu_vram_used" num)"
        printf ',"gpu_vram_total_mib":%s' "$(json_val "$gpu_vram_total" num)"
    fi

    if [[ "$LOG_CPU" == true ]]; then
        printf ',"cpu_freq_mhz":%s' "$(json_val "$cpu_freq" num)"
        printf ',"cpu_temp_c":%s' "$(json_val "$cpu_temp" num)"
        printf ',"cpu_usage_pct":%s' "$(json_val "$cpu_usage" num)"
        printf ',"nvme_temp_c":%s' "$(json_val "$nvme_temp" num)"
    fi

    printf '}\n'
}

# --- Setup ---
INTERVAL_SEC=$(awk "BEGIN {printf \"%.3f\", $INTERVAL_MS / 1000}")

if [[ -n "$OUTPUT" ]]; then
    exec 3>"$OUTPUT"
else
    exec 3>/dev/null
fi

cleanup() {
    if [[ "$LIVE" == true ]]; then
        # Restore terminal
        printf '\033[0m\n'
    fi
    exec 3>&- 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# Write header for CSV
if [[ "$FORMAT" == "csv" && "$LIVE" == false ]]; then
    if [[ -n "$OUTPUT" ]]; then
        emit_csv_header >&3
    fi
    if [[ "$QUIET" == false ]]; then
        emit_csv_header
    fi
fi

# Prime CPU usage reading (first sample needs two readings)
if [[ "$LOG_CPU" == true ]]; then
    read_cpu_usage > /dev/null
    sleep 0.05
fi

# --- Live dashboard ---
LIVE_HISTORY=""
live_draw() {
    local ts="$1"
    local gpu_freq="$2" gpu_volt="$3" gpu_temp="$4" gpu_load="$5" gpu_mem="$6"
    local gpu_power="$7" gpu_vram_used="$8" gpu_vram_total="$9"
    local cpu_freq="${10}" cpu_temp="${11}" cpu_usage="${12}" nvme_temp="${13}"

    # Clear screen and move cursor to top
    printf '\033[2J\033[H'

    # Header
    printf '\033[1;36m╔════════════════════════════════════════════════════════╗\033[0m\n'
    printf '\033[1;36m║\033[0m \033[1mhw-logger\033[0m live dashboard            %s \033[1;36m║\033[0m\n' "$ts"
    printf '\033[1;36m╠════════════════════════════════════════════════════════╣\033[0m\n'

    # GPU section
    if [[ "$LOG_GPU" == true ]]; then
        printf '\033[1;31mGPU\033[0m\n'
        printf '  Freq:   \033[1m%6s MHz\033[0m   Voltage: \033[1m%4s mV\033[0m\n' "${gpu_freq:--}" "${gpu_volt:--}"
        printf '  Temp:   \033[1m%6s °C\033[0m   Power:   \033[1m%6s W\033[0m\n' "${gpu_temp:--}" "${gpu_power:--}"
        printf '  Mem:    \033[1m%6s MHz\033[0m   VRAM:    \033[1m%s/%s MiB\033[0m\n' "${gpu_mem:--}" "${gpu_vram_used:--}" "${gpu_vram_total:--}"
    fi

    # CPU section
    if [[ "$LOG_CPU" == true ]]; then
        printf '\033[1;34mCPU\033[0m\n'
        printf '  Freq:   \033[1m%6s MHz\033[0m   Usage:   \033[1m%6s %%\033[0m\n' "${cpu_freq:--}" "${cpu_usage:--}"
        printf '  Temp:   \033[1m%6s °C\033[0m\n' "${cpu_temp:--}"
    fi

    # NVMe section
    if [[ -n "$nvme_temp" ]]; then
        printf '\033[1;32mNVMe\033[0m\n'
        printf '  Temp:   \033[1m%6s °C\033[0m\n' "$nvme_temp"
    fi

    # Footer
    printf '\033[1;36m╠════════════════════════════════════════════════════════╣\033[0m\n'
    printf '\033[2m║  Ctrl+C to exit                            Sample #%-5s║\033[0m\n' "$sample_count"
    printf '\033[1;36m╚════════════════════════════════════════════════════════╝\033[0m\n'
}

# --- Main loop ---
sample_count=0
while true; do
    ts=$(timestamp)

    # GPU
    gpu_freq="" gpu_volt="" gpu_temp="" gpu_load="" gpu_mem=""
    gpu_power="" gpu_vram_used="" gpu_vram_total=""
    if [[ "$LOG_GPU" == true ]]; then
        gpu_freq=$(read_gpu_freq) || true
        gpu_volt=$(read_gpu_voltage) || true
        gpu_temp=$(read_gpu_temp) || true
        gpu_load=$(read_gpu_load) || true
        gpu_mem=$(read_gpu_mem_clock) || true
        gpu_power=$(read_gpu_power) || true
        gpu_vram_used=$(read_gpu_vram_used) || true
        gpu_vram_total=$(read_gpu_vram_total) || true
    fi

    # CPU
    cpu_freq="" cpu_temp="" cpu_usage="" nvme_temp=""
    if [[ "$LOG_CPU" == true ]]; then
        cpu_freq=$(read_cpu_freq) || true
        cpu_temp=$(read_cpu_temp) || true
        cpu_usage=$(read_cpu_usage) || true
        nvme_temp=$(read_nvme_temp) || true
    fi

    # Output
    if [[ "$LIVE" == true ]]; then
        live_draw "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_load" "$gpu_mem" \
                  "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                  "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp"
    else
        if [[ -n "$OUTPUT" ]]; then
            case "$FORMAT" in
                csv) emit_csv "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_load" "$gpu_mem" \
                              "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                              "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp" >&3 ;;
                json) emit_json "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_load" "$gpu_mem" \
                                "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                                "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp" >&3 ;;
            esac
        fi

        if [[ "$QUIET" == false ]]; then
            case "$FORMAT" in
                csv) emit_csv "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_load" "$gpu_mem" \
                              "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                              "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp" ;;
                json) emit_json "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_load" "$gpu_mem" \
                                "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                                "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp" ;;
            esac
        fi
    fi

    sample_count=$((sample_count + 1))

    if [[ "$COUNT" -gt 0 && "$sample_count" -ge "$COUNT" ]]; then
        break
    fi

    sleep "$INTERVAL_SEC"
done

# --- Plot after logging ---
if [[ "$PLOT" == true || "$DRAW" == true ]]; then
    HW_DRAW=""
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -x "${SCRIPT_DIR}/hw-draw" ]]; then
        HW_DRAW="${SCRIPT_DIR}/hw-draw"
    elif command -v hw-draw &>/dev/null; then
        HW_DRAW="hw-draw"
    fi

    if [[ -z "$HW_DRAW" ]]; then
        echo "Warning: hw-draw not found, skipping plot." >&2
    else
        _plot_args=("$OUTPUT")
        if [[ -n "$PLOT_METRICS" ]]; then
            _plot_args+=(-m "$PLOT_METRICS")
        fi
        if [[ "$DRAW" == true ]]; then
            _plot_args+=(--draw)
        fi
        "$HW_DRAW" "${_plot_args[@]}"
    fi
fi

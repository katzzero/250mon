#!/usr/bin/env bash
#
# 250mon - Log GPU and CPU metrics for AMD Cyan Skillfish (BC-250) APU
#

set -euo pipefail

VERSION="0.1.0"

usage() {
    cat <<EOF
250mon v${VERSION} - AMD Cyan Skillfish hardware logger

Usage: 250mon [OPTIONS]

Component selection (default: both GPU and CPU):
  --gpu               Log GPU metrics only
  --cpu               Log CPU metrics only

Options:
  -i, --interval MS   Sampling interval in milliseconds (default: 1000)
  -f, --format FMT    Output format: csv or json (default: csv)
  -o, --output FILE   Log to file (default: ~/250mon-YYYYMMDD-HHMMSS.<ext>)
  -q, --quiet         Suppress stdout, write to file only
  -c, --count N       Number of samples then exit (default: infinite)
  --max-size SIZE     Rotate log at size limit (e.g., 10M, 500K, 1G)
  --rotate N          Keep max N rotated files (default: 5)
  -w, --watch         Single-line live display (Ctrl+C to exit)
  --live              Full-screen live dashboard (Ctrl+C to exit)
  --spark             Show sparklines in live dashboard
  --plot              Generate plot after logging (default: 30 samples)
  --draw              Print ASCII chart after logging (default: 60 samples)
  --plot-metrics M    Metrics to plot (comma-separated, passed to 250mon-draw)
  --per-core          Log per-core CPU frequencies instead of average
  --list-states       List GPU clock states and exit
  --service [ACTION]  Run as service (no arg: daemon; install|uninstall|start|stop|restart)
  --serve [PORT]      Start WebSocket server (default: 25052)
  -h, --help          Show this help message
  -v, --version       Show version

GPU Metrics:
  gpu_freq_mhz        GPU shader clock (MHz)
  gpu_voltage_mv      GPU core voltage (mV)
  gpu_temp_c          GPU temperature (°C)
  gpu_mem_clock_mhz   GPU memory clock (MHz)
  gpu_power_w         GPU power draw (W)
  gpu_vram_used_mib   VRAM used (MiB)
  gpu_vram_total_mib  VRAM total (MiB)

CPU Metrics:
  cpu_freq_mhz        Average CPU frequency (MHz)
  cpu_temp_c          CPU temperature (°C, from k10temp)
  cpu_usage_pct       Aggregate CPU usage percentage
  nvme_temp_c         NVMe drive temperature (°C)

Examples:
  250mon                              # Log to ~/250mon-YYYYMMDD-HHMMSS.csv
  250mon --gpu -i 100 -f json         # GPU only, 100ms interval, JSON
  250mon --cpu -i 500 -c 60           # CPU only, 500ms, 60 samples
  250mon -i 2000 -o hw.csv -q         # Custom file, quiet
  250mon --live                       # Full-screen live dashboard
  250mon --draw -c 30                 # Log 30 samples then show chart
  250mon --plot -c 50                 # Log 50 samples then save plot
  250mon --max-size 10M --rotate 3    # Rotate at 10MB, keep 3 files
  250mon --service                    # Run as background daemon
  250mon --service install            # Install systemd service
  250mon --service stop               # Stop service
  250mon --serve                      # Start WebSocket server on port 25052
  250mon --serve 8080                 # Start WebSocket server on custom port

Config file: ~/.config/250mon/config.toml
  interval = 1000
  format = "csv"
  gpu = true
  cpu = true
  max_size = "50M"
  rotate = 5
EOF
}

VERSION="0.1.0"

# Defaults
INTERVAL_MS=1000
FORMAT="csv"
OUTPUT=""
QUIET=false
COUNT=0
LOG_GPU=true
LOG_CPU=true
PLOT=false
DRAW=false
LIVE=false
WATCH=false
SPARK=false
PLOT_METRICS=""
MAX_SIZE=""
ROTATE=5
SERVICE=""
SERVICE_ACTION=""
SERVE=false
SERVE_PORT=25052
CONFIG_FILE="${HOME}/.config/250mon/config.toml"
STATE_DIR="/run/250mon"
PID_FILE="${STATE_DIR}/250mon.pid"
SERVICE_DAEMON=false
PER_CORE=false
LIST_STATES=false

# GPU sysfs base path
GPU_PATH=""

# Previous CPU stat for usage calculation
PREV_CPU_TOTAL=0
PREV_CPU_IDLE=0

# --- Load config file ---
load_config() {
    local cfg="$CONFIG_FILE"
    [[ ! -f "$cfg" ]] && return

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip inline comments (everything after #, but not inside quotes)
        line=$(echo "$line" | sed 's/\s*#.*$//')

        # Skip empty lines and comments
        [[ -z "$line" || "$line" =~ ^[[:space:]]*$ ]] && continue
        [[ "$line" =~ ^[[:space:]]*# ]] && continue

        # Skip section headers [section]
        [[ "$line" =~ ^\[.*\]$ ]] && continue

        # Extract key=value (with optional spaces around =)
        if [[ "$line" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            key="${BASH_REMATCH[1]}"
            val="${BASH_REMATCH[2]}"

            # Strip surrounding quotes (single or double)
            val="${val#\"}" && val="${val%\"}"
            val="${val#\'}" && val="${val%\'}"

            # Trim whitespace
            val=$(echo "$val" | xargs)

            case "$key" in
                interval)
                    if [[ "$val" =~ ^[0-9]+$ && "$val" -ge 1 ]]; then
                        INTERVAL_MS="$val"
                    else
                        echo "Warning: Invalid interval '$val' in config, ignoring." >&2
                    fi
                    ;;
                format)
                    if [[ "$val" == "csv" || "$val" == "json" ]]; then
                        FORMAT="$val"
                    else
                        echo "Warning: Invalid format '$val' in config, ignoring." >&2
                    fi
                    ;;
                output)      OUTPUT="$val" ;;
                quiet)       [[ "$val" == "true" ]] && QUIET=true; [[ "$val" == "false" ]] && QUIET=false ;;
                gpu)         [[ "$val" == "true" ]] && LOG_GPU=true; [[ "$val" == "false" ]] && LOG_GPU=false ;;
                cpu)         [[ "$val" == "true" ]] && LOG_CPU=true; [[ "$val" == "false" ]] && LOG_CPU=false ;;
                max_size)
                    if [[ "$val" =~ ^[0-9]+[KkMmGg]?$ ]]; then
                        MAX_SIZE="$val"
                    else
                        echo "Warning: Invalid max_size '$val' in config, ignoring." >&2
                    fi
                    ;;
                rotate)
                    if [[ "$val" =~ ^[0-9]+$ && "$val" -ge 1 ]]; then
                        ROTATE="$val"
                    else
                        echo "Warning: Invalid rotate '$val' in config, ignoring." >&2
                    fi
                    ;;
            esac
        fi
    done < "$cfg"
}

load_config

# --- Argument parsing ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --gpu)
            LOG_GPU=true
            LOG_CPU=false
            shift
            ;;
        --cpu)
            LOG_GPU=false
            LOG_CPU=true
            shift
            ;;
        -i|--interval)
            INTERVAL_MS="$2"
            shift 2
            ;;
        -f|--format)
            FORMAT="$2"
            shift 2
            ;;
        -o|--output)
            OUTPUT="$2"
            shift 2
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -c|--count)
            COUNT="$2"
            shift 2
            ;;
        --plot)
            PLOT=true
            shift
            ;;
        --draw)
            DRAW=true
            shift
            ;;
        --live)
            LIVE=true
            shift
            ;;
        -w|--watch)
            WATCH=true
            shift
            ;;
        --spark)
            SPARK=true
            shift
            ;;
        --plot-metrics)
            PLOT_METRICS="$2"
            shift 2
            ;;
        --max-size)
            MAX_SIZE="$2"
            shift 2
            ;;
        --rotate)
            ROTATE="$2"
            shift 2
            ;;
        --service)
            SERVICE=true
            if [[ $# -gt 1 && "$2" != --* ]]; then
                SERVICE_ACTION="$2"
                shift 2
            else
                shift
            fi
            ;;
        --service-daemon)
            SERVICE=true
            SERVICE_DAEMON=true
            shift
            ;;
        --serve)
            SERVE=true
            if [[ $# -gt 1 && "$2" != --* && "$2" =~ ^[0-9]+$ ]]; then
                SERVE_PORT="$2"
                shift 2
            else
                shift
            fi
            ;;
        --per-core)
            PER_CORE=true
            shift
            ;;
        --list-states)
            LIST_STATES=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            echo "250mon v${VERSION}"
            exit 0
            ;;
        *)
            echo "Error: Unknown option '$1'" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# If --draw or --plot without -c, set a default count
if [[ "$DRAW" == true && "$COUNT" -eq 0 ]]; then
    COUNT=60
elif [[ "$PLOT" == true && "$COUNT" -eq 0 ]]; then
    COUNT=30
fi

# --- Validation ---
if [[ "$FORMAT" != "csv" && "$FORMAT" != "json" ]]; then
    echo "Error: Invalid format '$FORMAT'. Use 'csv' or 'json'." >&2
    exit 1
fi

if ! [[ "$INTERVAL_MS" =~ ^[0-9]+$ ]] || [[ "$INTERVAL_MS" -lt 1 ]]; then
    echo "Error: Interval must be a positive integer (ms)." >&2
    exit 1
fi

# --- Parse size string (e.g., 10M -> bytes) ---
parse_size() {
    local s="$1"
    local num unit
    num=$(echo "$s" | sed 's/[^0-9.]//g')
    unit=$(echo "$s" | sed 's/[0-9.]//g' | tr '[:lower:]' '[:upper:]')
    case "$unit" in
        K)  awk "BEGIN {printf \"%.0f\", $num * 1024}" ;;
        M)  awk "BEGIN {printf \"%.0f\", $num * 1048576}" ;;
        G)  awk "BEGIN {printf \"%.0f\", $num * 1073741824}" ;;
        "") awk "BEGIN {printf \"%.0f\", $num}" ;;
        *)  echo "0" ;;
    esac
}

# --- Log rotation ---
rotate_log() {
    [[ -z "$OUTPUT" || ! -f "$OUTPUT" ]] && return
    [[ -z "$MAX_SIZE" ]] && return

    local max_bytes
    max_bytes=$(parse_size "$MAX_SIZE")
    local file_size
    file_size=$(stat -c%s "$OUTPUT" 2>/dev/null || echo 0)

    [[ "$file_size" -lt "$max_bytes" ]] && return

    # Close fd 3 before rotating
    exec 3>&- 2>/dev/null || true

    # Remove oldest
    local last="${OUTPUT}.${ROTATE}"
    [[ -f "$last" ]] && rm -f "$last"

    # Shift: .N-1 -> .N, ..., .1 -> .2
    local i=$((ROTATE - 1))
    while [[ $i -ge 1 ]]; do
        local src="${OUTPUT}.${i}"
        local dst="${OUTPUT}.$((i + 1))"
        [[ -f "$src" ]] && mv "$src" "$dst"
        i=$((i - 1))
    done

    # Current -> .1
    mv "$OUTPUT" "${OUTPUT}.1"

    # Reopen fd 3
    exec 3>"$OUTPUT"

    # Rewrite CSV header
    if [[ "$FORMAT" == "csv" ]]; then
        emit_csv_header >&3
    fi
}

# --- Default output path ---
if [[ -z "$OUTPUT" ]]; then
    _ext="csv"
    [[ "$FORMAT" == "json" ]] && _ext="jsonl"
    OUTPUT="${HOME}/250mon-$(date '+%Y%m%d-%H%M%S').${_ext}"
fi

# --- Find GPU sysfs path ---
find_gpu_path() {
    local card
    for card in /sys/class/drm/card*/device; do
        if [[ -f "$card/pp_dpm_sclk" ]]; then
            echo "$card"
            return 0
        fi
    done
    return 1
}

if [[ "$LOG_GPU" == true ]]; then
    GPU_PATH=$(find_gpu_path) || {
        echo "Warning: AMD GPU sysfs not found, disabling GPU logging." >&2
        LOG_GPU=false
    }
fi

# --- GPU reading functions ---
read_gpu_freq() {
    grep '\*' "$GPU_PATH/pp_dpm_sclk" 2>/dev/null | head -1 | sed -n 's/^[0-9]*: \([0-9]*\)Mhz.*/\1/p'
}

read_gpu_voltage() {
    grep '^OD_VDDC:' -A1 "$GPU_PATH/pp_od_clk_voltage" 2>/dev/null | tail -1 | sed -n 's/^[0-9]*: \([0-9]*\)mV.*/\1/p'
}

read_gpu_temp() {
    local hwmon_dir="$GPU_PATH/hwmon"
    local hwmon temp_file raw
    for hwmon in "$hwmon_dir"/*/; do
        temp_file="${hwmon}temp1_input"
        if [[ -f "$temp_file" ]]; then
            raw=$(cat "$temp_file" 2>/dev/null) || return 0
            if [[ -n "$raw" ]]; then
                awk "BEGIN {printf \"%.1f\", $raw / 1000}"
                return 0
            fi
        fi
    done
}

read_gpu_mem_clock() {
    grep '\*' "$GPU_PATH/pp_dpm_mclk" 2>/dev/null | head -1 | sed -n 's/^[0-9]*: \([0-9]*\)Mhz.*/\1/p'
}

read_gpu_power() {
    local hwmon_dir="$GPU_PATH/hwmon"
    local hwmon power_file raw
    for hwmon in "$hwmon_dir"/*/; do
        power_file="${hwmon}power1_average"
        if [[ -f "$power_file" ]]; then
            raw=$(cat "$power_file" 2>/dev/null) || return 0
            if [[ -n "$raw" ]]; then
                awk "BEGIN {printf \"%.1f\", $raw / 1000000}"
                return 0
            fi
        fi
    done
}

read_gpu_vram_used() {
    local f="$GPU_PATH/mem_info_vram_used"
    if [[ -f "$f" ]]; then
        local val
        val=$(cat "$f" 2>/dev/null) || return 0
        awk "BEGIN {printf \"%.0f\", $val / 1048576}"
    fi
}

read_gpu_vram_total() {
    local f="$GPU_PATH/mem_info_vram_total"
    if [[ -f "$f" ]]; then
        local val
        val=$(cat "$f" 2>/dev/null) || return 0
        awk "BEGIN {printf \"%.0f\", $val / 1048576}"
    fi
}

# --- CPU reading functions ---
read_cpu_freq() {
    # Average frequency across all cores from /proc/cpuinfo
    awk '/^cpu MHz/ {sum += $4; n++} END {if (n>0) printf "%.0f", sum/n; else print ""}' /proc/cpuinfo 2>/dev/null
}

read_cpu_temp() {
    # k10temp from hwmon
    local hwmon_dir="/sys/class/hwmon"
    local hwmon name_file temp_file
    for hwmon in "$hwmon_dir"/*/; do
        name_file="${hwmon}name"
        if [[ -f "$name_file" ]]; then
            name=$(cat "$name_file" 2>/dev/null)
            if [[ "$name" == "k10temp" ]]; then
                temp_file="${hwmon}temp1_input"
                if [[ -f "$temp_file" ]]; then
                    local raw
                    raw=$(cat "$temp_file" 2>/dev/null) || return 0
                    if [[ -n "$raw" ]]; then
                        awk "BEGIN {printf \"%.1f\", $raw / 1000}"
                        return 0
                    fi
                fi
            fi
        fi
    done
}

read_cpu_usage() {
    # Read /proc/stat and calculate CPU usage since last call
    local vals
    vals=$(awk '/^cpu / && !/^cpu[0-9]/ {
        printf "%s %s %s %s %s %s %s %s", $2, $3, $4, $5, $6, $7, $8, $9
        exit
    }' /proc/stat 2>/dev/null) || return 0

    local user nice system idle iowait irq softirq steal
    read -r user nice system idle iowait irq softirq steal <<< "$vals"

    local total=$((user + nice + system + idle + iowait + irq + softirq + steal))
    local idle_total=$((idle + iowait))

    if [[ "$PREV_CPU_TOTAL" -gt 0 ]]; then
        local delta_total=$((total - PREV_CPU_TOTAL))
        local delta_idle=$((idle_total - PREV_CPU_IDLE))
        if [[ "$delta_total" -gt 0 ]]; then
            awk "BEGIN {printf \"%.1f\", (1 - $delta_idle / $delta_total) * 100}"
        fi
    fi

    PREV_CPU_TOTAL=$total
    PREV_CPU_IDLE=$idle_total
}

# --- NVMe reading function ---
read_nvme_temp() {
    local hwmon_dir="/sys/class/hwmon"
    local hwmon name_file temp_file
    for hwmon in "$hwmon_dir"/*/; do
        name_file="${hwmon}name"
        if [[ -f "$name_file" ]]; then
            name=$(cat "$name_file" 2>/dev/null)
            if [[ "$name" == "nvme" ]]; then
                temp_file="${hwmon}temp1_input"
                if [[ -f "$temp_file" ]]; then
                    local raw
                    raw=$(cat "$temp_file" 2>/dev/null) || return 0
                    if [[ -n "$raw" ]]; then
                        awk "BEGIN {printf \"%.1f\", $raw / 1000}"
                        return 0
                    fi
                fi
            fi
        fi
    done
}

# --- Per-core CPU frequency ---
read_cpu_freq_per_core() {
    # Returns comma-separated frequencies for each core
    awk '/^processor/ {core=$3} /^cpu MHz/ {printf "%s%.0f", (core>0 ? "," : ""), $4} END {print ""}' /proc/cpuinfo 2>/dev/null
}

# --- GPU clock states ---
list_gpu_clock_states() {
    local GPU_PATH=""
    local device_path="/sys/class/drm/card0/device"
    if [[ -d "$device_path" ]]; then
        GPU_PATH="$device_path"
    fi

    if [[ -z "$GPU_PATH" ]]; then
        echo "Error: Cannot find GPU sysfs path" >&2
        return 1
    fi

    echo "=== GPU Clock States (pp_dpm_sclk) ==="
    if [[ -f "$GPU_PATH/pp_dpm_sclk" ]]; then
        cat "$GPU_PATH/pp_dpm_sclk"
    else
        echo "Not available"
    fi
    echo

    echo "=== GPU Memory States (pp_dpm_mclk) ==="
    if [[ -f "$GPU_PATH/pp_dpm_mclk" ]]; then
        cat "$GPU_PATH/pp_dpm_mclk"
    else
        echo "Not available"
    fi
    echo

    echo "=== GPU Voltage States (pp_od_clk_voltage) ==="
    if [[ -f "$GPU_PATH/pp_od_clk_voltage" ]]; then
        cat "$GPU_PATH/pp_od_clk_voltage"
    else
        echo "Not available"
    fi
}

# --- Output functions ---
timestamp() {
    date '+%Y-%m-%dT%H:%M:%S%z'
}

emit_csv_header() {
    local header="timestamp"
    [[ "$LOG_GPU" == true ]] && header+=",gpu_freq_mhz,gpu_voltage_mv,gpu_temp_c,gpu_mem_clock_mhz,gpu_power_w,gpu_vram_used_mib,gpu_vram_total_mib"
    if [[ "$LOG_CPU" == true ]]; then
        if [[ "$PER_CORE" == true ]]; then
            # Get number of cores
            local ncores
            ncores=$(awk '/^processor/ {n=$3} END {print n+1}' /proc/cpuinfo 2>/dev/null || echo 12)
            local i=0
            while [[ $i -lt $ncores ]]; do
                header+=",cpu${i}_freq_mhz"
                i=$((i + 1))
            done
            header+=",cpu_temp_c,cpu_usage_pct,nvme_temp_c"
        else
            header+=",cpu_freq_mhz,cpu_temp_c,cpu_usage_pct,nvme_temp_c"
        fi
    fi
    echo "$header"
}

emit_csv() {
    local ts="$1"
    local gpu_freq="$2" gpu_volt="$3" gpu_temp="$4" gpu_mem="$5"
    local gpu_power="$6" gpu_vram_used="$7" gpu_vram_total="$8"
    local cpu_freq="$9" cpu_temp="${10}" cpu_usage="${11}" nvme_temp="${12}"
    local per_core_data="${13}"

    local line="$ts"
    if [[ "$LOG_GPU" == true ]]; then
        line+=",${gpu_freq},${gpu_volt},${gpu_temp},${gpu_mem}"
        line+=",${gpu_power},${gpu_vram_used},${gpu_vram_total}"
    fi
    if [[ "$LOG_CPU" == true ]]; then
        if [[ "$PER_CORE" == true ]]; then
            line+=",${per_core_data}"
            line+=",${cpu_temp},${cpu_usage},${nvme_temp}"
        else
            line+=",${cpu_freq},${cpu_temp},${cpu_usage},${nvme_temp}"
        fi
    fi
    echo "$line"
}

json_val() {
    # Return "null" for empty, or the value quoted for strings, unquoted for numbers
    local val="$1" type="${2:-string}"
    if [[ -z "$val" ]]; then
        echo "null"
    elif [[ "$type" == "string" ]]; then
        printf '"%s"' "$val"
    else
        echo "$val"
    fi
}

emit_json() {
    local ts="$1"
    local gpu_freq="$2" gpu_volt="$3" gpu_temp="$4" gpu_mem="$5"
    local gpu_power="$6" gpu_vram_used="$7" gpu_vram_total="$8"
    local cpu_freq="$9" cpu_temp="${10}" cpu_usage="${11}" nvme_temp="${12}"
    local per_core_data="${13}"

    printf '{"timestamp":"%s"' "$ts"

    if [[ "$LOG_GPU" == true ]]; then
        printf ',"gpu_freq_mhz":%s' "$(json_val "$gpu_freq" num)"
        printf ',"gpu_voltage_mv":%s' "$(json_val "$gpu_volt" num)"
        printf ',"gpu_temp_c":%s' "$(json_val "$gpu_temp" num)"
        printf ',"gpu_mem_clock_mhz":%s' "$(json_val "$gpu_mem" num)"
        printf ',"gpu_power_w":%s' "$(json_val "$gpu_power" num)"
        printf ',"gpu_vram_used_mib":%s' "$(json_val "$gpu_vram_used" num)"
        printf ',"gpu_vram_total_mib":%s' "$(json_val "$gpu_vram_total" num)"
    fi

    if [[ "$LOG_CPU" == true ]]; then
        if [[ "$PER_CORE" == true ]]; then
            # per_core_data is comma-separated freqs: "freq0,freq1,..."
            local IFS=','
            local core_idx=0
            for freq in $per_core_data; do
                printf ',"cpu%d_freq_mhz":%s' "$core_idx" "$(json_val "$freq" num)"
                core_idx=$((core_idx + 1))
            done
        else
            printf ',"cpu_freq_mhz":%s' "$(json_val "$cpu_freq" num)"
        fi
        printf ',"cpu_temp_c":%s' "$(json_val "$cpu_temp" num)"
        printf ',"cpu_usage_pct":%s' "$(json_val "$cpu_usage" num)"
        printf ',"nvme_temp_c":%s' "$(json_val "$nvme_temp" num)"
    fi

    printf '}\n'
}

# --- Service functions ---
write_state() {
    local gpu_freq="$1" gpu_volt="$2" gpu_temp="$3" gpu_mem="$4"
    local gpu_power="$5" gpu_vram_used="$6" gpu_vram_total="$7"
    local cpu_freq="$8" cpu_temp="$9" cpu_usage="${10}" nvme_temp="${11}"

    [[ ! -d "$STATE_DIR" ]] && mkdir -p "$STATE_DIR"

    # Individual files
    [[ -n "$gpu_freq" ]] && echo "$gpu_freq" > "${STATE_DIR}/gpu_freq"
    [[ -n "$gpu_volt" ]] && echo "$gpu_volt" > "${STATE_DIR}/gpu_voltage"
    [[ -n "$gpu_temp" ]] && echo "$gpu_temp" > "${STATE_DIR}/gpu_temp"
    [[ -n "$gpu_mem" ]] && echo "$gpu_mem" > "${STATE_DIR}/gpu_mem_clock"
    [[ -n "$gpu_power" ]] && echo "$gpu_power" > "${STATE_DIR}/gpu_power"
    [[ -n "$gpu_vram_used" ]] && echo "$gpu_vram_used" > "${STATE_DIR}/gpu_vram_used"
    [[ -n "$gpu_vram_total" ]] && echo "$gpu_vram_total" > "${STATE_DIR}/gpu_vram_total"
    [[ -n "$cpu_freq" ]] && echo "$cpu_freq" > "${STATE_DIR}/cpu_freq"
    [[ -n "$cpu_temp" ]] && echo "$cpu_temp" > "${STATE_DIR}/cpu_temp"
    [[ -n "$cpu_usage" ]] && echo "$cpu_usage" > "${STATE_DIR}/cpu_usage"
    [[ -n "$nvme_temp" ]] && echo "$nvme_temp" > "${STATE_DIR}/nvme_temp"

    # JSON state file
    printf '{"gpu_freq":%s,"gpu_voltage":%s,"gpu_temp":%s,"gpu_mem_clock":%s,"gpu_power":%s,"gpu_vram_used":%s,"gpu_vram_total":%s,"cpu_freq":%s,"cpu_temp":%s,"cpu_usage":%s,"nvme_temp":%s}\n' \
        "$(json_val "${gpu_freq}" num)" \
        "$(json_val "${gpu_volt}" num)" \
        "$(json_val "${gpu_temp}" num)" \
        "$(json_val "${gpu_mem}" num)" \
        "$(json_val "${gpu_power}" num)" \
        "$(json_val "${gpu_vram_used}" num)" \
        "$(json_val "${gpu_vram_total}" num)" \
        "$(json_val "${cpu_freq}" num)" \
        "$(json_val "${cpu_temp}" num)" \
        "$(json_val "${cpu_usage}" num)" \
        "$(json_val "${nvme_temp}" num)" > "${STATE_DIR}/state.json"
}

service_install() {
    echo "Installing 250mon service..."

    # Create tmpfiles.d config
    mkdir -p /etc/tmpfiles.d
    cat > /etc/tmpfiles.d/250mon.conf <<TMPFILES
d /run/250mon 0755 root root -
TMPFILES

    # Create systemd unit
    cat > /etc/systemd/system/250mon.service <<'UNIT'
[Unit]
Description=250mon Hardware Monitor
After=multi-user.target

[Service]
Type=simple
Environment=HOME=/root
ExecStart=/usr/local/bin/250mon -q -i 1000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

    systemctl daemon-reload
    systemctl enable 250mon.service
    systemctl start 250mon.service
    echo "Service installed and started."
}

service_uninstall() {
    echo "Stopping 250mon service..."
    systemctl stop 250mon.service 2>/dev/null || true
    systemctl disable 250mon.service 2>/dev/null || true
    rm -f /etc/systemd/system/250mon.service
    rm -f /etc/tmpfiles.d/250mon.conf
    systemctl daemon-reload
    echo "Service removed."
}

service_start() {
    systemctl start 250mon.service
    echo "Service started."
}

service_stop() {
    systemctl stop 250mon.service
    echo "Service stopped."
}

service_restart() {
    systemctl restart 250mon.service
    echo "Service restarted."
}

service_status() {
    systemctl status 250mon.service
}

# Handle --serve (start WebSocket server and exit)
if [[ "$SERVE" == true ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    SERVE_SCRIPT=""
    if [[ -x "${SCRIPT_DIR}/250mon-serve" ]]; then
        SERVE_SCRIPT="${SCRIPT_DIR}/250mon-serve"
    elif command -v 250mon-serve &>/dev/null; then
        SERVE_SCRIPT="250mon-serve"
    fi

    if [[ -z "$SERVE_SCRIPT" ]]; then
        echo "Error: 250mon-serve not found." >&2
        exit 1
    fi

    echo "Starting WebSocket server on port $SERVE_PORT..."
    exec "$SERVE_SCRIPT" "$SERVE_PORT"
fi

# Handle --service actions early (before main loop)
if [[ "$SERVICE" == true ]]; then
    case "$SERVICE_ACTION" in
        install)   service_install; exit 0 ;;
        uninstall) service_uninstall; exit 0 ;;
        start)     service_start; exit 0 ;;
        stop)      service_stop; exit 0 ;;
        restart)   service_restart; exit 0 ;;
        status)    service_status; exit 0 ;;
        "")        ;; # Daemon mode, handled below
        *)
            echo "Error: Unknown service action '$SERVICE_ACTION'" >&2
            echo "Usage: 250mon --service [install|uninstall|start|stop|restart|status]" >&2
            exit 1
            ;;
    esac
fi

# --- Setup ---
INTERVAL_SEC=$(awk "BEGIN {printf \"%.3f\", $INTERVAL_MS / 1000}")

if [[ -n "$OUTPUT" ]]; then
    exec 3>"$OUTPUT"
else
    exec 3>/dev/null
fi

cleanup() {
    if [[ "$LIVE" == true || "$WATCH" == true ]]; then
        # Restore terminal
        printf '\033[0m\n'
    fi
    exec 3>&- 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# --- Daemon mode for --service ---
if [[ "$SERVICE" == true && "$SERVICE_DAEMON" == false ]]; then
    mkdir -p "$STATE_DIR"

    # Check if already running
    if [[ -f "$PID_FILE" ]]; then
        local_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [[ -n "$local_pid" ]] && kill -0 "$local_pid" 2>/dev/null; then
            echo "250mon service already running (PID $local_pid)"
            exit 1
        fi
        rm -f "$PID_FILE"
    fi

    # Fork to background using internal daemon flag
    nohup 250mon --service-daemon > /dev/null 2>&1 &
    echo $! > "$PID_FILE"
    echo "250mon service started (PID $!)"
    exit 0
fi

# --- List GPU states and exit ---
if [[ "$LIST_STATES" == true ]]; then
    list_gpu_clock_states
    exit 0
fi

# Write header for CSV
if [[ "$FORMAT" == "csv" && "$LIVE" == false && "$WATCH" == false ]]; then
    if [[ -n "$OUTPUT" ]]; then
        emit_csv_header >&3
    fi
    if [[ "$QUIET" == false ]]; then
        emit_csv_header
    fi
fi

# Prime CPU usage reading (first sample needs two readings)
if [[ "$LOG_CPU" == true ]]; then
    read_cpu_usage > /dev/null
    sleep 0.05
fi

# --- Live dashboard ---
LIVE_GPU_TEMP_HIST=()
LIVE_CPU_TEMP_HIST=()
LIVE_GPU_POWER_HIST=()
LIVE_CPU_USAGE_HIST=()
LIVE_SPARK=" ▁▂▃▄▅▆▇█"
LIVE_MAX_HIST=60

live_sparkline() {
    local -n arr=$1
    local w=$2
    local len=${#arr[@]}
    if [[ "$len" -eq 0 ]]; then
        printf '%0.s ' $(seq 1 $w)
        return
    fi
    # Use awk for min/max/sparkline
    printf '%s\n' "${arr[@]}" | awk -v w="$w" -v blocks=" ▁▂▃▄▅▆▇█" '
    {
        a[NR]=$1
        if(NR==1){mn=$1;mx=$1}
        if($1<mn)mn=$1
        if($1>mx)mx=$1
    }
    END {
        n=NR
        if(n==0)exit
        range=mx-mn
        if(range==0)range=1
        step=1
        if(n>w)step=n/w
        nb=length(blocks)
        out=""
        i=1
        while(i<=n){
            idx=int(i)
            if(idx<1)idx=1
            if(idx>n)idx=n
            v=a[idx]
            bi=int((v-mn)/range*(nb-1))
            if(bi<0)bi=0
            if(bi>=nb)bi=nb-1
            out=out substr(blocks,bi+1,1)
            i=i+step
        }
        printf "%s", out
    }'
}

live_draw() {
    local ts="$1"
    local gpu_freq="$2" gpu_volt="$3" gpu_temp="$4" gpu_mem="$5"
    local gpu_power="$6" gpu_vram_used="$7" gpu_vram_total="$8"
    local cpu_freq="$9" cpu_temp="${10}" cpu_usage="${11}" nvme_temp="${12}"

    printf '\033[2J\033[H'

    local R="\033[1;31m"
    local G="\033[1;34m"
    local N="\033[1;32m"
    local D="\033[2m"
    local W="\033[1m"
    local X="\033[0m"

    printf "${W}250mon live dashboard${X}  %s\n" "$ts"
    printf '%0.s-' {1..60}
    echo

    if [[ "$LOG_GPU" == true ]]; then
        printf "${R}GPU${X}\n"
        printf "  Freq: ${W}%6s${X} MHz   Voltage: ${W}%4s${X} mV\n" "${gpu_freq:--}" "${gpu_volt:--}"
        printf "  Temp: ${W}%6s${X} °C   Power:   ${W}%6s${X} W\n" "${gpu_temp:--}" "${gpu_power:--}"
        printf "  Mem:  ${W}%6s${X} MHz   VRAM:    ${W}%s/%s${X} MiB\n" "${gpu_mem:--}" "${gpu_vram_used:--}" "${gpu_vram_total:--}"
        if [[ "$SPARK" == true && ${#LIVE_GPU_TEMP_HIST[@]} -gt 1 ]]; then
            printf "  ${D}temp:${X} "
            live_sparkline LIVE_GPU_TEMP_HIST 40
            echo
            printf "  ${D}power:${X} "
            live_sparkline LIVE_GPU_POWER_HIST 40
            echo
        fi
    fi

    if [[ "$LOG_CPU" == true ]]; then
        printf "${G}CPU${X}\n"
        printf "  Freq: ${W}%6s${X} MHz   Usage:   ${W}%6s${X} %%\n" "${cpu_freq:--}" "${cpu_usage:--}"
        printf "  Temp: ${W}%6s${X} °C\n" "${cpu_temp:--}"
        if [[ "$SPARK" == true && ${#LIVE_CPU_TEMP_HIST[@]} -gt 1 ]]; then
            printf "  ${D}usage:${X} "
            live_sparkline LIVE_CPU_USAGE_HIST 40
            echo
            printf "  ${D}temp: ${X} "
            live_sparkline LIVE_CPU_TEMP_HIST 40
            echo
        fi
    fi

    if [[ -n "$nvme_temp" ]]; then
        printf "${N}NVMe${X}\n"
        printf "  Temp: ${W}%6s${X} °C\n" "$nvme_temp"
    fi

    printf '%0.s-' {1..60}
    echo
    printf "  ${D}Ctrl+C to exit${X}  ${W}sample #%-5s${X}\n" "$sample_count"
}

watch_draw() {
    local ts="$1"
    local gpu_freq="$2" gpu_volt="$3" gpu_temp="$4" gpu_mem="$5"
    local gpu_power="$6" gpu_vram_used="$7" gpu_vram_total="$8"
    local cpu_freq="$9" cpu_temp="${10}" cpu_usage="${11}" nvme_temp="${12}"

    local R=$'\033[1;31m'
    local G=$'\033[1;34m'
    local W=$'\033[1m'
    local D=$'\033[2m'
    local X=$'\033[0m'

    # Build single line
    local line=""
    if [[ "$LOG_GPU" == true ]]; then
        line+="${R}GPU${X} ${W}${gpu_freq:--}${X}MHz ${gpu_temp:--}°C ${gpu_power:--}W "
    fi
    if [[ "$LOG_CPU" == true ]]; then
        line+="${G}CPU${X} ${W}${cpu_freq:--}${X}MHz ${cpu_temp:--}°C ${cpu_usage:--}% "
    fi
    if [[ -n "$nvme_temp" ]]; then
        line+="${D}NVMe${X} ${nvme_temp}°C "
    fi

    printf '\r\033[K%s' "$line"
}

# --- Main loop ---
sample_count=0
while true; do
    ts=$(timestamp)

    # GPU
    gpu_freq="" gpu_volt="" gpu_temp="" gpu_mem=""
    gpu_power="" gpu_vram_used="" gpu_vram_total=""
    if [[ "$LOG_GPU" == true ]]; then
        gpu_freq=$(read_gpu_freq) || true
        gpu_volt=$(read_gpu_voltage) || true
        gpu_temp=$(read_gpu_temp) || true
        gpu_mem=$(read_gpu_mem_clock) || true
        gpu_power=$(read_gpu_power) || true
        gpu_vram_used=$(read_gpu_vram_used) || true
        gpu_vram_total=$(read_gpu_vram_total) || true
    fi

    # CPU
    cpu_freq="" cpu_temp="" cpu_usage="" nvme_temp="" per_core_data=""
    if [[ "$LOG_CPU" == true ]]; then
        if [[ "$PER_CORE" == true ]]; then
            per_core_data=$(read_cpu_freq_per_core) || true
            # Calculate average for watch/live display
            cpu_freq=$(echo "$per_core_data" | awk -F',' '{sum=0; for(i=1;i<=NF;i++) sum+=$i; if(NF>0) printf "%.0f", sum/NF; else print ""}')
        else
            cpu_freq=$(read_cpu_freq) || true
        fi
        cpu_temp=$(read_cpu_temp) || true
        cpu_usage=$(read_cpu_usage) || true
        nvme_temp=$(read_nvme_temp) || true
    fi

    # Output
    if [[ "$WATCH" == true ]]; then
        watch_draw "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_mem" \
                   "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                   "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp"
    elif [[ "$LIVE" == true ]]; then
        # Collect history for sparklines
        [[ -n "$gpu_temp" ]] && LIVE_GPU_TEMP_HIST+=("$gpu_temp")
        [[ -n "$gpu_power" ]] && LIVE_GPU_POWER_HIST+=("$gpu_power")
        [[ -n "$cpu_temp" ]] && LIVE_CPU_TEMP_HIST+=("$cpu_temp")
        [[ -n "$cpu_usage" ]] && LIVE_CPU_USAGE_HIST+=("$cpu_usage")
        # Trim to max
        [[ ${#LIVE_GPU_TEMP_HIST[@]} -gt $LIVE_MAX_HIST ]] && LIVE_GPU_TEMP_HIST=("${LIVE_GPU_TEMP_HIST[@]:1}")
        [[ ${#LIVE_GPU_POWER_HIST[@]} -gt $LIVE_MAX_HIST ]] && LIVE_GPU_POWER_HIST=("${LIVE_GPU_POWER_HIST[@]:1}")
        [[ ${#LIVE_CPU_TEMP_HIST[@]} -gt $LIVE_MAX_HIST ]] && LIVE_CPU_TEMP_HIST=("${LIVE_CPU_TEMP_HIST[@]:1}")
        [[ ${#LIVE_CPU_USAGE_HIST[@]} -gt $LIVE_MAX_HIST ]] && LIVE_CPU_USAGE_HIST=("${LIVE_CPU_USAGE_HIST[@]:1}")

        live_draw "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_mem" \
                  "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                  "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp"
    else
        if [[ -n "$OUTPUT" ]]; then
            case "$FORMAT" in
                csv) emit_csv "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_mem" \
                              "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                              "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp" "$per_core_data" >&3 ;;
                json) emit_json "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_mem" \
                                "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                                "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp" "$per_core_data" >&3 ;;
            esac
        fi

        if [[ "$QUIET" == false ]]; then
            case "$FORMAT" in
                csv) emit_csv "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_mem" \
                              "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                              "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp" "$per_core_data" ;;
                json) emit_json "$ts" "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_mem" \
                                "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                                "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp" "$per_core_data" ;;
            esac
        fi
    fi

    # Write state files for --service mode
    if [[ "$SERVICE" == true ]]; then
        write_state "$gpu_freq" "$gpu_volt" "$gpu_temp" "$gpu_mem" \
                    "$gpu_power" "$gpu_vram_used" "$gpu_vram_total" \
                    "$cpu_freq" "$cpu_temp" "$cpu_usage" "$nvme_temp"
    fi

    sample_count=$((sample_count + 1))

    # Rotate log if needed
    rotate_log

    # Show countdown when --draw is active
    if [[ "$DRAW" == true && "$QUIET" == false && "$LIVE" == false ]]; then
        remaining=$((COUNT - sample_count))
        printf "\r\033[2mSampling... %d remaining\033[0m " "$remaining" >&2
    fi

    if [[ "$COUNT" -gt 0 && "$sample_count" -ge "$COUNT" ]]; then
        break
    fi

    sleep "$INTERVAL_SEC"
done

# --- Plot after logging ---
if [[ "$PLOT" == true || "$DRAW" == true ]]; then
    HW_DRAW=""
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -x "${SCRIPT_DIR}/250mon-draw" ]]; then
        HW_DRAW="${SCRIPT_DIR}/250mon-draw"
    elif command -v 250mon-draw &>/dev/null; then
        HW_DRAW="250mon-draw"
    fi

    if [[ -z "$HW_DRAW" ]]; then
        echo "Warning: 250mon-draw not found, skipping plot." >&2
    else
        _plot_args=("$OUTPUT")
        if [[ -n "$PLOT_METRICS" ]]; then
            _plot_args+=(-m "$PLOT_METRICS")
        fi
        if [[ "$DRAW" == true ]]; then
            _plot_args+=(--draw)
        fi
        "$HW_DRAW" "${_plot_args[@]}"
    fi
fi
